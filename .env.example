# IMBERE DATA — runtime configuration.
#
# Copy to `.env` and adjust locally, or set these in the deployment dashboard.
# Every value below is a placeholder, not a secret. Nothing here is required:
# each variable has a sensible default for a fresh clone.

# ---------------------------------------------------------------------------
# API (FastAPI, api/app/main.py)
# ---------------------------------------------------------------------------

# Comma-separated exact origins allowed to call the API. "*" is what a clone
# needs against http://localhost:3000. A deployment should list its frontend.
IMBERE_ALLOW_ORIGINS=*

# Regex for preview deployments whose hostnames change per branch.
# Example: https://.*\.vercel\.app
IMBERE_ALLOW_ORIGIN_REGEX=

# POST requests per client per minute, compute endpoints only. 0 disables it.
IMBERE_RATE_LIMIT=90

# Cache-Control max-age, in seconds, for GET /api/* responses.
IMBERE_CACHE_SECONDS=300

# Fit the model in a background thread at startup (1) or lazily on first use (0).
IMBERE_WARM_ON_STARTUP=1

# Entries in the bounded LRU over deterministic POST responses. 0 disables it.
IMBERE_POST_CACHE=128

# Optional path to a frozen model payload (written by scripts/freeze_model.py
# at image build time). Leave empty to fit from data/processed on first access.
IMBERE_MODEL_CACHE=

# ---------------------------------------------------------------------------
# Interface (Next.js, web/lib/api.ts)
# ---------------------------------------------------------------------------

# Base URL of the API. Read at BUILD time — redeploy after changing it.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
